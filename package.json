{
  "name": "token-inspectour",
  "version": "0.2.0",
  "description": "Local proxy and browser UI that maps every span of each Claude Code request to the CLAUDE.md, skill, command, agent, hook, MCP, or harness source that produced it, with token counts per step.",
  "type": "module",
  "bin": {
    "token-inspectour": "bin/token-inspectour.js"
  },
  "files": [
    "bin",
    "dist/src",
    "ui",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "prepare": "npm run build",
    "start": "node bin/token-inspectour.js",
    "test": "npm run build && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude-code",
    "anthropic",
    "tokens",
    "context-window",
    "proxy",
    "prompt-inspector",
    "agents",
    "mcp"
  ],
  "author": "Jim",
  "license": "MIT",
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
