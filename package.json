{
  "name": "token-inspectour",
  "version": "0.1.0",
  "description": "See what Claude Code actually sends to the model: a local proxy + UI that maps every span of each request back to the CLAUDE.md, skill, command, agent, hook, MCP and harness source that produced it, with exact token counts per step.",
  "type": "module",
  "bin": {
    "token-inspectour": "bin/token-inspectour.js"
  },
  "files": [
    "bin",
    "dist/src",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "prepare": "npm run build",
    "start": "node bin/token-inspectour.js",
    "test": "npm run build && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude-code",
    "anthropic",
    "tokens",
    "context-window",
    "proxy",
    "prompt-inspector",
    "agents",
    "mcp"
  ],
  "author": "Jim",
  "license": "MIT",
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
